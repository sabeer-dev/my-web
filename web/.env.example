# Absolute URL used for metadata and social previews.
NEXT_PUBLIC_SITE_URL=https://sabeer-dev.github.io/my-web

# Supabase project URL and publishable key. The publishable key is designed
# for browser use; row-level security in supabase/schema.sql protects writes.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# The admin page (/admin) requires a Supabase Auth user whose app_metadata
# contains {"role":"admin"}. See supabase/schema.sql for the setup steps.
